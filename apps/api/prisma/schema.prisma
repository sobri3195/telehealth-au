generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum UserRole { PATIENT DOCTOR NURSE HEALTH_FACILITY_ADMIN CENTRAL_ADMIN SUPER_ADMIN }
enum PatientStatus { PRAJURIT PNS KELUARGA SISWA PURNAWIRAWAN MASYARAKAT_UMUM }
enum UnitType { KOTAMA LANUD WING DEPOHAR BALAKPUS PUSKESAU OTHER }
enum FacilityType { PUSKESAU RSPAU RSAU LAKESGILUTAU LAKESPRA LAFIAU CLINIC OTHER }
enum NeedType { CONSULTATION SUDDEN_COMPLAINT EMERGENCY FOLLOW_UP PRESCRIPTION_REFILL MEDICATION_QUESTION REFERRAL DENTAL FLIGHT_HEALTH PSYCHOLOGY UPLOAD_LAB FIND_FACILITY CONTACT_ADMIN }
enum NeedStatus { DRAFT SUBMITTED TRIAGED ASSIGNED IN_CONSULTATION COMPLETED CANCELLED }
enum PriorityLevel { GREEN YELLOW RED }
enum ConsultationStatus { QUEUED ACTIVE CLOSED CANCELLED }
enum MessageSenderType { PATIENT DOCTOR NURSE ADMIN SYSTEM }
enum MessageStatus { SENT DELIVERED READ }
enum AttachmentType { IMAGE PDF LAB_RESULT PRESCRIPTION REFERRAL MEDICAL_DOCUMENT OTHER }
enum NotificationType { TRIAGE EMERGENCY MESSAGE ASSIGNMENT REFERRAL PRESCRIPTION SYSTEM }

model User { id String @id @default(cuid()) email String? @unique identityNumber String @unique phone String? passwordHash String role UserRole @default(PATIENT) isActive Boolean @default(true) refreshTokenHash String? patientProfile PatientProfile? medicalStaffProfile MedicalStaffProfile? sentMessages ConsultationMessage[] notifications Notification[] auditLogs AuditLog[] @relation("ActorAuditLogs") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model PatientProfile { id String @id @default(cuid()) userId String @unique user User @relation(fields:[userId],references:[id]) fullName String status PatientStatus rank String? corps String? organizationUnitId String? organizationUnit OrganizationUnit? @relation(fields:[organizationUnitId],references:[id]) kotama String? nearestBase String? address String? bloodType String? allergies String? medicalHistory String? routineMedication String? emergencyContact String? preferredFacilityId String? preferredFacility HealthFacility? @relation(fields:[preferredFacilityId],references:[id]) needs PatientNeed[] consultations Consultation[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model MedicalStaffProfile { id String @id @default(cuid()) userId String @unique user User @relation(fields:[userId],references:[id]) fullName String profession String specialty String? licenseNumber String? organizationUnitId String? organizationUnit OrganizationUnit? @relation(fields:[organizationUnitId],references:[id]) facilityId String? facility HealthFacility? @relation(fields:[facilityId],references:[id]) consultations Consultation[] schedules Schedule[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model OrganizationUnit { id String @id @default(cuid()) name String type UnitType @default(OTHER) parentId String? parent OrganizationUnit? @relation("UnitHierarchy",fields:[parentId],references:[id]) children OrganizationUnit[] @relation("UnitHierarchy") address String? city String? province String? phone String? latitude Float? longitude Float? isActive Boolean @default(true) facilities HealthFacility[] patients PatientProfile[] staff MedicalStaffProfile[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([name,parentId]) }
model HealthFacility { id String @id @default(cuid()) name String type FacilityType organizationUnitId String? organizationUnit OrganizationUnit? @relation(fields:[organizationUnitId],references:[id]) address String? city String province String phone String? services String[] operationalHours String? latitude Float? longitude Float? isActive Boolean @default(true) patients PatientProfile[] staff MedicalStaffProfile[] schedules Schedule[] referrals Referral[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model NeedQuestion { id String @id @default(cuid()) needType NeedType label String inputType String options String[] isRedFlag Boolean @default(false) sortOrder Int @default(0) isActive Boolean @default(true) createdAt DateTime @default(now()) }
model PatientNeed { id String @id @default(cuid()) patientId String patient PatientProfile @relation(fields:[patientId],references:[id]) type NeedType status NeedStatus @default(DRAFT) priority PriorityLevel @default(GREEN) summary String? recommendedAction String? assignedFacilityId String? answers PatientNeedAnswer[] triage TriageAssessment? consultation Consultation? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model PatientNeedAnswer { id String @id @default(cuid()) patientNeedId String patientNeed PatientNeed @relation(fields:[patientNeedId],references:[id],onDelete:Cascade) questionKey String questionLabel String value Json createdAt DateTime @default(now()) }
model TriageAssessment { id String @id @default(cuid()) patientNeedId String @unique patientNeed PatientNeed @relation(fields:[patientNeedId],references:[id],onDelete:Cascade) priority PriorityLevel redFlags String[] recommendation String assessedBy String @default("SYSTEM") createdAt DateTime @default(now()) }
model Consultation { id String @id @default(cuid()) patientId String patient PatientProfile @relation(fields:[patientId],references:[id]) patientNeedId String? @unique patientNeed PatientNeed? @relation(fields:[patientNeedId],references:[id]) medicalStaffId String? medicalStaff MedicalStaffProfile? @relation(fields:[medicalStaffId],references:[id]) status ConsultationStatus @default(QUEUED) priority PriorityLevel @default(GREEN) mode String @default("chat") messages ConsultationMessage[] attachments ConsultationAttachment[] medicalRecords MedicalRecord[] prescription Prescription? referral Referral? startedAt DateTime? closedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model ConsultationMessage { id String @id @default(cuid()) consultationId String consultation Consultation @relation(fields:[consultationId],references:[id],onDelete:Cascade) senderId String? sender User? @relation(fields:[senderId],references:[id]) senderType MessageSenderType body String? status MessageStatus @default(SENT) attachments ConsultationAttachment[] createdAt DateTime @default(now()) readAt DateTime? }
model ConsultationAttachment { id String @id @default(cuid()) consultationId String consultation Consultation @relation(fields:[consultationId],references:[id],onDelete:Cascade) messageId String? message ConsultationMessage? @relation(fields:[messageId],references:[id]) type AttachmentType fileName String mimeType String sizeBytes Int storageKey String url String createdAt DateTime @default(now()) }
model MedicalRecord { id String @id @default(cuid()) consultationId String consultation Consultation @relation(fields:[consultationId],references:[id],onDelete:Cascade) subjective String objective String assessment String plan String diagnosis String? education String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Prescription { id String @id @default(cuid()) consultationId String @unique consultation Consultation @relation(fields:[consultationId],references:[id],onDelete:Cascade) items Json notes String? issuedAt DateTime @default(now()) }
model Referral { id String @id @default(cuid()) consultationId String @unique consultation Consultation @relation(fields:[consultationId],references:[id],onDelete:Cascade) targetFacilityId String targetFacility HealthFacility @relation(fields:[targetFacilityId],references:[id]) reason String diagnosis String? documentUrl String? status String @default("DRAFT") createdAt DateTime @default(now()) }
model Schedule { id String @id @default(cuid()) staffId String staff MedicalStaffProfile @relation(fields:[staffId],references:[id]) facilityId String facility HealthFacility @relation(fields:[facilityId],references:[id]) startsAt DateTime endsAt DateTime quota Int @default(8) createdAt DateTime @default(now()) }
model Notification { id String @id @default(cuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) type NotificationType title String body String readAt DateTime? metadata Json? createdAt DateTime @default(now()) }
model AuditLog { id String @id @default(cuid()) actorId String? actor User? @relation("ActorAuditLogs",fields:[actorId],references:[id]) action String resource String resourceId String? ipAddress String? userAgent String? metadata Json? createdAt DateTime @default(now()) }
